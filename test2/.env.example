# Relative paths are resolved from the project root, regardless of cwd.
DATABASE_URL=sqlite:///./database/app.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# mock works offline. Set openai explicitly to enable external analysis.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
